//- 标签球开关：tag_sphere.enable 为 false 时退回普通标签云
- var sphereOn = !(theme.tag_sphere && theme.tag_sphere.enable === false)

if sphereOn
  - var tagItems = []
  - site.tags.each(function (tag) { tagItems.push({ name: tag.name, count: tag.length, path: url_for(tag.path) }) })
  - var tagJson = JSON.stringify(tagItems).replace(/</g, '\\u003c')
  - var sphereDepth = (theme.tag_sphere && theme.tag_sphere.depth) === 'back' ? 'back' : 'front'
  - var sphereFade = Number(theme.tag_sphere && theme.tag_sphere.min_opacity)
  - var sphereMin = isNaN(sphereFade) ? 0.3 : Math.min(1, Math.max(0, sphereFade))

  #tag-sphere.tag-sphere(data-depth=sphereDepth, data-min-opacity=sphereMin)
    canvas.tag-sphere-canvas
    .tag-sphere-tip
    script.tag-sphere-data(type='application/json')!= tagJson
    ul.tag-sphere-sr
      each item in tagItems
        li
          a(href=item.path)= item.name + '（' + item.count + '）'
else
  .tag-cloud-list.is-center
    !=cloudTags({ source: site.tags, minfontsize: 1.2, maxfontsize: 2.1, limit: 0, unit: 'em' })
